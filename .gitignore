# Scratch and working directories. Accumulators are gigabytes and rebuild
# from the source data, so they must never be tracked.
odyn_scratch/
nb_work_*/
scratchpad/
*.dat
tmp

# Local database snapshots. These are copies of the shared odyn.db taken to
# avoid holding a SQLite lock on the share; they go stale by design and must
# not be a second source of truth.
*.db
*.db-journal

# Imaging data and derived arrays. These live beside the sessions on the
# server, under processed/python/, not in version control.
*.tif
*.tiff
*.h5
*.npz
*.mat
*.avi

# Python
__pycache__/
*.py[codz]
.ipynb_checkpoints/
*.egg-info

# Figure/analysis outputs. These regenerate from source data via the
# scripts that produce them, so they must never be tracked.
analysis/figures/*_outputs/
analysis/figures/*_outputs_*/
analysis/figures/*_smoke/
analysis/figures/spatial_maps_10x/
analysis/figures/figure*/outputs/
analysis/results/
analysis/eda/report/deck_figures/
qc_preview_20x*/

# System / IDE
.DS_Store
.vscode/

# Claude related
.claude